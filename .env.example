# =====================================================================
#  ZenCamp — Variables de la pile Docker
#
#  Copier ce fichier en « .env » (ignoré par git) et adapter les valeurs.
#  Aucun secret réel ne doit être versionné : un mot de passe poussé sur
#  GitHub est compromis définitivement.
# =====================================================================

# --- Ports exposés sur la machine hôte -------------------------------
ZENCAMP_PORT=8080
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306

# --- Base de données --------------------------------------------------
MYSQL_DATABASE=zencamp
MYSQL_ROOT_PASSWORD=root_developpement

# Compte applicatif à privilèges limités (SELECT/INSERT/UPDATE/DELETE).
# Doit correspondre au mot de passe de docker/mysql/30-utilisateur-docker.sql.
ZENCAMP_DB_USER=zencamp_app
ZENCAMP_DB_PASSWORD=mot_de_passe_developpement

# --- Chiffrement des données de santé ---------------------------------
# Clé AES-256 en base64 (32 octets décodés).
# Générer la vôtre : php -r "echo base64_encode(random_bytes(32));"
ZENCAMP_CLE_CHIFFREMENT=
